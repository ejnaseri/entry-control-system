# EntryControl System - sample environment variables
# Application edition (case-sensitive): FULL or ATTENDANCE
# ATTENDANCE starts only capabilities that have passed their activation gates
APP_EDITION=FULL
# IANA timezone used for business-day and shift boundaries
APP_TIMEZONE=Asia/Kabul
# Attendance v1 supports TIME_CLOCK only; shifts classify punches but do not gate recording
ATTENDANCE_POLICY=TIME_CLOCK
# Reserved switch: Attendance auto-checkout remains non-operational in v1 until a separately approved scope change
ATTENDANCE_AUTO_CHECKOUT_ENABLED=0
# Attendance Inbox is fail-closed. Keep 0 until every O.2 release gate passes.
APP_FEATURE_INBOX=0
PORT=4000
DATABASE_URL="postgresql://ecs_example:CHANGE_ME@localhost:5432/ecs_db?schema=public"

# Device integration (ZKTeco K40)
ZKTECO_HOST=192.0.2.10
ZKTECO_PORT=4370
# Set this only if device Comm Key is configured; otherwise leave blank
ZKTECO_PASS=
ZKTECO_POLL_INTERVAL_MS=5000

# Door relay integration
DOOR_RELAY_HOST=192.0.2.20
DOOR_RELAY_PORT=80
DOOR_RELAY_PATH=/relay/open
DOOR_OPEN_SECONDS=5
