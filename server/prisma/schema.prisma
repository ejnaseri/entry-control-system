generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Individuals that interact with the center.
model Member {
  id                       String                    @id @default(cuid())
  code                     String                    @unique
  fingerId                 Int?
  memberType               MemberType                @default(CUSTOMER)
  firstName                String
  lastName                 String?
  fatherName               String?
  phone                    String?
  email                    String?
  gender                   Gender?
  birthDate                DateTime?
  nationalId               String?
  photoUrl                 String?
  status                   MemberStatus              @default(ACTIVE)
  isBlacklisted            Boolean                   @default(false)
  notes                    String?
  staffProfile             StaffProfile?
  customerProfile          CustomerProfile?
  roleType                 MemberRoleType?
  isStaff                  Boolean                   @default(false)
  customTitle              String?
  archivedAt               DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  accessWarnings           AccessViolation[]
  attendanceLogs           AttendanceLog[]
  deviceUser               DeviceUser?
  doorEvents               DoorEvent[]
  inboxItems               InboxItem[]
  memberships              Membership[]
  payments                 Payment[]
  payrollPeriods           PayrollPeriod[]
  payrollPolicies          PayrollPolicy[]
  themePreferences         ThemePreference[]
  accessPolicy             MemberAccessPolicy?
  overtimePolicy           MemberOvertimePolicy?
  shifts                   MemberShift[]
  attendanceJustifications AttendanceJustification[]
  staffGroupId             String?
  staffGroup               StaffGroup?               @relation(fields: [staffGroupId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([phone])
  @@index([email])
  @@index([staffGroupId])
  @@index([memberType, isStaff, archivedAt])
}

/// Manual justifications for absent days.
model AttendanceJustification {
  id        String   @id @default(cuid())
  memberId  String
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, date])
  @@index([date])
}

model StaffProfile {
  id         String   @id @default(cuid())
  memberId   String   @unique
  position   String?
  department String?
  systemRole String?
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CustomerProfile {
  id                    String              @id @default(cuid())
  memberId              String              @unique
  member                Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  totalPaidAmount       Int                 @default(0)
  totalDebtAmount       Int                 @default(0)
  defaultAccessPolicyId String?             @unique
  defaultAccessPolicy   MemberAccessPolicy? @relation("DefaultAccessPolicy", fields: [defaultAccessPolicyId], references: [id], onDelete: SetNull)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

/// Allowed days and time ranges for a member.
model MemberAccessPolicy {
  id               String             @id @default(cuid())
  memberId         String             @unique
  allowedDays      Int[]              @default([])
  rules            MemberAccessRule[]
  maxEntriesPerDay Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  member           Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  customerProfile  CustomerProfile?   @relation("DefaultAccessPolicy")
}

model MemberAccessRule {
  id        String             @id @default(cuid())
  policyId  String
  weekday   Int
  fromTime  String
  toTime    String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  policy    MemberAccessPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId, weekday])
}

/// Overtime permission and rates per member.
model MemberOvertimePolicy {
  id                String            @id @default(cuid())
  memberId          String            @unique
  allowOvertime     Boolean           @default(false)
  overtimeRateType  OvertimeRateType?
  overtimeAmount    Decimal?          @db.Decimal(10, 2)
  maxOvertimePerDay Decimal?          @db.Decimal(5, 2)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  member            Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

/// Shift definitions for staff/members.
model MemberShift {
  id                 String           @id @default(cuid())
  memberId           String
  shiftId            String?
  shiftName          String
  shiftStart         String
  shiftEnd           String
  weekdays           Int[]            @default([0, 1, 2, 3, 4, 5, 6])
  graceMinutes       Int              @default(0)
  earlyAccessMinutes Int              @default(15)
  salaryType         SalaryType
  salaryAmount       Decimal          @db.Decimal(12, 2)
  rateOverride       Decimal?         @db.Decimal(12, 2)
  isFromGroup        Boolean          @default(false)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  member             Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  template           StaffGroupShift? @relation("TemplateToMemberShifts", fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([memberId, isActive])
  @@index([shiftId])
  @@index([memberId, isFromGroup])
}

/// Reusable shift collections that can be attached to staff.
model StaffGroup {
  id              String            @id @default(cuid())
  name            String
  description     String?
  accessLevel     String?
  shifts          StaffGroupShift[]
  members         Member[]
  payrollPolicies PayrollPolicy[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

/// Shift templates that belong to a staff group.
model StaffGroupShift {
  id                 String        @id @default(cuid())
  staffGroupId       String
  shiftName          String
  shiftStart         String
  shiftEnd           String
  weekdays           Int[]         @default([0, 1, 2, 3, 4, 5, 6])
  graceMinutes       Int           @default(0)
  earlyAccessMinutes Int           @default(15)
  salaryType         SalaryType
  salaryAmount       Decimal       @db.Decimal(12, 2)
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  staffGroup         StaffGroup    @relation(fields: [staffGroupId], references: [id], onDelete: Cascade)
  memberShifts       MemberShift[] @relation("TemplateToMemberShifts")

  @@index([staffGroupId, isActive])
}

/// Mapping between ECS members and ZKTeco device slots.
model DeviceUser {
  id               String            @id @default(cuid())
  externalId       Int               @unique
  pin              String?
  cardNumber       String?
  fingerprintHash  String?
  deviceId         String?
  lastSyncedAt     DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  memberId         String?           @unique
  accessViolations AccessViolation[]
  attendanceLogs   AttendanceLog[]
  member           Member?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
}

/// Subscription plans.
model MembershipPlan {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?
  durationDays    Int
  price           Decimal          @db.Decimal(12, 2)
  currency        String           @default("AFN")
  visitLimit      Int?
  gracePeriodDays Int?             @default(0)
  isActive        Boolean          @default(true)
  color           String?
  durationValue   Int              @default(1)
  durationUnit    PlanDurationUnit @default(MONTHS)
  basePrice       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  memberships     Membership[]
}

/// Concrete membership instances assigned to members.
model Membership {
  id               String           @id @default(cuid())
  memberId         String
  planId           String
  startDate        DateTime
  endDate          DateTime
  expiresAt        DateTime
  status           MembershipStatus @default(PENDING)
  basePrice        Decimal          @db.Decimal(12, 2)
  discount         Decimal          @default(0) @db.Decimal(12, 2)
  totalDue         Decimal          @db.Decimal(12, 2)
  totalPaid        Decimal          @default(0) @db.Decimal(12, 2)
  autoRenew        Boolean          @default(false)
  notes            String?
  activatedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  createdByAdminId String?
  createdBy        AdminUser?       @relation("MembershipCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  member           Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan             MembershipPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments         Payment[]

  @@index([memberId, status])
  @@index([status, endDate, memberId])
}

/// Incoming payments for memberships.
model Payment {
  id                String        @id @default(cuid())
  memberId          String
  membershipId      String?
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("AFN")
  method            PaymentMethod @default(CASH)
  status            PaymentStatus @default(PAID)
  reference         String?
  dueDate           DateTime?
  paidAt            DateTime?
  notes             String?
  recordedByAdminId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  member            Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membership        Membership?   @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  recordedBy        AdminUser?    @relation(fields: [recordedByAdminId], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@index([membershipId])
  @@index([status, dueDate])
  @@index([status, paidAt])
  @@index([status, createdAt])
}

/// Expense categories for cash outflows.
model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]

  @@index([isActive, sortOrder])
}

/// Append-only expense ledger entries. Reversals are stored as negative rows.
model Expense {
  id                  String          @id @default(cuid())
  categoryId          String
  amount              Decimal         @db.Decimal(12, 2)
  currency            String          @default("AFN")
  status              ExpenseStatus   @default(POSTED)
  occurredAt          DateTime
  notes               String?
  reference           String?
  vendorName          String?
  isAdjustment        Boolean         @default(false)
  reversalOfExpenseId String?         @unique
  reversedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  category            ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reversalOf          Expense?        @relation("ExpenseReversal", fields: [reversalOfExpenseId], references: [id], onDelete: SetNull)
  reversedBy          Expense?        @relation("ExpenseReversal")

  @@index([categoryId, occurredAt])
  @@index([status, occurredAt])
  @@index([occurredAt])
}

model PayrollPeriod {
  id          String           @id @default(cuid())
  memberId    String
  year        Int
  month       Int
  baseAmount  Decimal          @db.Decimal(12, 2)
  adjustments Decimal          @default(0) @db.Decimal(12, 2)
  totalDue    Decimal          @db.Decimal(12, 2)
  status      PayrollStatus    @default(UNPAID)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  member      Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  payments    PayrollPayment[]

  @@unique([memberId, year, month])
  @@index([year, month])
  @@index([status])
}

model PayrollPayment {
  id                String        @id @default(cuid())
  payrollPeriodId   String
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("AFN")
  method            PaymentMethod @default(CASH)
  status            PaymentStatus @default(PAID)
  paidAt            DateTime?
  notes             String?
  breakdown         Json?
  recordedByAdminId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  payrollPeriod     PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  recordedBy        AdminUser?    @relation(fields: [recordedByAdminId], references: [id], onDelete: SetNull)

  @@index([paidAt])
}

model PayrollPolicy {
  id                        String             @id @default(cuid())
  scope                     PayrollPolicyScope @default(GLOBAL)
  memberId                  String?
  staffGroupId              String?
  allowAttendanceDeductions Boolean            @default(true)
  absenceMode               PayrollCalcMode    @default(PROPORTIONAL)
  absenceDeductionAmount    Decimal?           @db.Decimal(12, 2)
  lateMode                  PayrollCalcMode    @default(PROPORTIONAL)
  lateDeductionAmount       Decimal?           @db.Decimal(12, 2)
  lateIgnoreMinutes         Int                @default(0)
  earlyLeaveMode            PayrollCalcMode    @default(PROPORTIONAL)
  earlyLeaveDeductionAmount Decimal?           @db.Decimal(12, 2)
  earlyLeaveIgnoreMinutes   Int                @default(0)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  member                    Member?            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  staffGroup                StaffGroup?        @relation(fields: [staffGroupId], references: [id], onDelete: Cascade)

  @@index([scope])
  @@index([memberId])
  @@index([staffGroupId])
}

/// Raw device pulls for deduplication/audit.
model DeviceRawLog {
  id           String             @id @default(cuid())
  deviceId     String
  recordedAt   DateTime
  dataHash     String             @unique
  payload      Json
  status       DeviceRawLogStatus @default(PENDING)
  processError String?
  processedAt  DateTime?
  createdAt    DateTime           @default(now())
  attendance   AttendanceLog?     @relation("RawLogToAttendance")
  device       Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, recordedAt])
  @@index([status, createdAt])
}

/// Normalized attendance entries.
model AttendanceLog {
  id           String           @id @default(cuid())
  memberId     String?
  deviceUserId String?
  rawLogId     String?          @unique
  entryType    AttendanceType   @default(IN)
  recordedAt   DateTime
  source       AttendanceSource @default(DEVICE)
  isAuthorized Boolean          @default(true)
  reason       String?
  dedupeKey    String?          @unique
  createdAt    DateTime         @default(now())
  deviceUser   DeviceUser?      @relation(fields: [deviceUserId], references: [id], onDelete: SetNull)
  member       Member?          @relation(fields: [memberId], references: [id], onDelete: SetNull)
  rawLog       DeviceRawLog?    @relation("RawLogToAttendance", fields: [rawLogId], references: [id], onDelete: SetNull)

  @@index([memberId, recordedAt])
  @@index([deviceUserId, recordedAt])
  @@index([recordedAt])
  @@index([entryType, recordedAt])
  @@index([entryType, isAuthorized, recordedAt, memberId])
}

/// Unified inbox for alerts + device feed history.
model InboxItem {
  id         String           @id @default(cuid())
  scope      InboxScope       @default(FULL)
  category   InboxCategory
  type       InboxItemType
  severity   InboxSeverity
  title      String
  body       String?
  createdAt  DateTime         @default(now())
  readAt     DateTime?
  entityType InboxEntityType?
  entityId   String?
  actionPath String?
  dedupeKey  String?
  deviceId   String?
  memberId   String?
  device     Device?          @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  member     Member?          @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([category, createdAt])
  @@index([readAt])
  @@index([deviceId, createdAt])
  @@index([memberId, createdAt])
  @@index([scope, category, createdAt])
  @@index([scope, readAt])
  @@unique([scope, dedupeKey])
}

/// Uploaded sound assets for system notifications.
model SoundAsset {
  id         String          @id @default(cuid())
  name       String
  mimeType   String
  size       Int
  durationMs Int
  data       Bytes
  createdAt  DateTime        @default(now())
  allowedFor SoundSettings[] @relation("SoundAllowed")
  deniedFor  SoundSettings[] @relation("SoundDenied")
  alertFor   SoundSettings[] @relation("SoundAlert")

  @@index([createdAt])
}

/// Global sound settings for notifications.
model SoundSettings {
  id                   String   @id @default("global")
  enabled              Boolean  @default(true)
  accessAllowedSoundId String?
  accessDeniedSoundId  String?
  alertSoundId         String?
  accessAllowedVolume  Float    @default(0.8)
  accessDeniedVolume   Float    @default(0.8)
  alertVolume          Float    @default(0.8)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  accessAllowedSound SoundAsset? @relation("SoundAllowed", fields: [accessAllowedSoundId], references: [id], onDelete: SetNull)
  accessDeniedSound  SoundAsset? @relation("SoundDenied", fields: [accessDeniedSoundId], references: [id], onDelete: SetNull)
  alertSound         SoundAsset? @relation("SoundAlert", fields: [alertSoundId], references: [id], onDelete: SetNull)
}

/// Any rejected access attempt.
model AccessViolation {
  id               String                @id @default(cuid())
  memberId         String?
  deviceUserId     String?
  reason           AccessViolationReason
  occurredAt       DateTime              @default(now())
  handledByAdminId String?
  notes            String?
  deviceUser       DeviceUser?           @relation(fields: [deviceUserId], references: [id], onDelete: SetNull)
  handledBy        AdminUser?            @relation(fields: [handledByAdminId], references: [id], onDelete: SetNull)
  member           Member?               @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([memberId, occurredAt])
  @@index([reason, occurredAt])
}

/// Door relay actions and manual overrides.
model DoorEvent {
  id          String          @id @default(cuid())
  memberId    String?
  adminUserId String?
  triggerType DoorTriggerType
  triggerRef  String?
  action      DoorAction
  relayId     String?
  requestedAt DateTime        @default(now())
  completedAt DateTime?
  success     Boolean         @default(true)
  notes       String?
  adminUser   AdminUser?      @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  member      Member?         @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([requestedAt])
}

/// Background job for report generation.
model ReportJob {
  id               String       @id @default(cuid())
  type             ReportType
  format           ReportFormat
  status           ReportStatus @default(PENDING)
  filters          Json?
  generatedFileUrl String?
  requestedById    String?
  completedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  requestedBy      AdminUser?   @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([status])
}

/// K/V settings for global configuration.
model SystemSetting {
  key         String           @id
  value       String
  valueType   SettingValueType @default(TEXT)
  scope       SettingScope     @default(GLOBAL)
  updatedById String?
  updatedAt   DateTime         @default(now())
  updatedBy   AdminUser?       @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Text resources for Dari/Pashto UI.
model TranslationEntry {
  id        String     @id @default(cuid())
  namespace String     @default("common")
  key       String
  language  UILanguage
  text      String
  context   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([namespace, key, language])
}

/// Stores selected theme/language per admin (or global scope).
model ThemePreference {
  id           String      @id @default(cuid())
  scope        ThemeScope  @default(GLOBAL)
  adminUserId  String?
  memberId     String?
  theme        ThemeMode   @default(SYSTEM)
  primaryColor String?
  accentColor  String?
  language     UILanguage? @default(DARI)
  storedAt     DateTime    @default(now())
  adminUser    AdminUser?  @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  member       Member?     @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([scope])
  @@index([adminUserId])
  @@index([memberId])
}

/// Backend operators of the ECS.
model AdminUser {
  id                               String                @id @default(cuid())
  username                         String                @unique
  email                            String?               @unique
  fullName                         String?
  passwordHash                     String
  role                             AdminRole             @default(RECEPTION)
  isActive                         Boolean               @default(true)
  isProtected                      Boolean               @default(false)
  lastLoginAt                      DateTime?
  passwordChangedAt                DateTime?
  deactivatedAt                    DateTime?
  vendorMaintenanceActivatedAt     DateTime?
  vendorMaintenanceExpiresAt       DateTime?
  vendorMaintenanceReason          String?
  vendorMaintenanceActivatedById   String?
  createdAt                        DateTime              @default(now())
  updatedAt                        DateTime              @updatedAt
  violationsHandled                AccessViolation[]
  auditLogs                        AuditLog[]
  backupJobs                       BackupJob[]
  operationRuns                    OperationRun[]
  restoreJobs                      RestoreJob[]
  doorEvents                       DoorEvent[]
  failedAttempts                   FailedLoginAttempt[]
  createdMemberships               Membership[]          @relation("MembershipCreatedBy")
  paymentsRecorded                 Payment[]
  payrollPayments                  PayrollPayment[]
  reportJobs                       ReportJob[]
  settingsUpdated                  SystemSetting[]
  themePreferences                 ThemePreference[]
  sessions                         AdminSession[]
  permissionOverrides              AdminUserPermission[]

  @@index([role, isActive])
  @@index([isProtected])
  @@index([role, vendorMaintenanceExpiresAt])
  @@index([vendorMaintenanceActivatedById])
}

/// Server-side login sessions for admin users.
model AdminSession {
  id          String     @id @default(cuid())
  adminUserId String
  tokenHash   String     @unique
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())
  lastSeenAt  DateTime   @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  adminUser   AdminUser  @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  auditLogs   AuditLog[]

  @@index([adminUserId, expiresAt])
  @@index([revokedAt])
}

/// Default permissions assigned to a base role.
model AdminRolePermission {
  id         String          @id @default(cuid())
  role       AdminRole
  permission AdminPermission
  createdAt  DateTime        @default(now())

  @@unique([role, permission])
  @@index([role])
  @@index([permission])
}

/// Per-user permission override for exceptional cases.
model AdminUserPermission {
  id          String          @id @default(cuid())
  adminUserId String
  permission  AdminPermission
  mode        PermissionMode  @default(ALLOW)
  reason      String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  adminUser   AdminUser       @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, permission])
  @@index([permission])
  @@index([mode])
}

/// Login throttling log.
model FailedLoginAttempt {
  id          String     @id @default(cuid())
  adminUserId String?
  username    String
  ipAddress   String?
  userAgent   String?
  reason      String?
  occurredAt  DateTime   @default(now())
  resolvedAt  DateTime?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([username, occurredAt])
  @@index([ipAddress, occurredAt])
}

/// Immutable audit trail.
model AuditLog {
  id           String        @id @default(cuid())
  actorType    AuditActor    @default(SYSTEM)
  actorId      String?
  actorRole    AdminRole?
  action       String
  targetType   String?
  targetId     String?
  success      Boolean       @default(true)
  ipAddress    String?
  userAgent    String?
  sessionId    String?
  requestId    String?
  beforeData   Json?
  afterData    Json?
  metadata     Json?
  createdAt    DateTime      @default(now())
  adminUser    AdminUser?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  adminSession AdminSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([sessionId])
  @@index([success, createdAt])
}

/// Offline licensing data.
model License {
  id             String        @id @default("license")
  licenseKey     String?
  status         LicenseStatus @default(PENDING)
  validFrom      DateTime?
  validUntil     DateTime?
  activatedAt    DateTime?
  lastVerifiedAt DateTime?
  lockedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

/// Backup/restore jobs log.
model BackupJob {
  id                 String                   @id @default(cuid())
  type               BackupJobType            @default(MANUAL)
  status             BackupStatus             @default(PENDING)
  verificationStatus BackupVerificationStatus @default(NOT_VERIFIED)
  startedAt          DateTime                 @default(now())
  finishedAt         DateTime?
  verifiedAt         DateTime?
  location           String?
  backupRoot         String?
  manifestPath       String?
  logPath            String?
  scheduleFrequency  String?
  sizeBytes          BigInt?
  sha256             String?
  errorMessage       String?
  triggeredById      String?
  triggeredBy        AdminUser?               @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  restoreJobs        RestoreJob[]             @relation("RestoreEmergencyBackup")
  updatedAt          DateTime                 @updatedAt

  @@index([status])
  @@index([type, startedAt])
  @@index([type, scheduleFrequency, startedAt])
  @@index([verificationStatus])
}

/// Controlled restore/import preparation and execution log.
model RestoreJob {
  id                       String           @id @default(cuid())
  status                   RestoreJobStatus @default(REQUESTED)
  selectedBackupId         String
  selectedBackupPath       String
  selectedBackupFolderName String?
  selectedBackupSha256     String?
  selectedBackupSizeBytes  BigInt?
  restoreTestDatabase      String?
  restoreTestPassedAt      DateTime?
  restoreTestReportPath    String?
  emergencyBackupJobId     String?
  emergencyBackupPath      String?
  handoffPath              String?
  restoreScriptPath        String?
  restoreCommand           Json?
  maintenanceStartedAt     DateTime?
  maintenanceEndedAt       DateTime?
  productionRestoreReportPath  String?
  productionRestoreStatus      String?
  productionRestoreCompletedAt DateTime?
  postRestoreCheckedAt         DateTime?
  postRestoreSummary           Json?
  requestedById            String?
  requestedAt              DateTime         @default(now())
  preparedAt               DateTime?
  finishedAt               DateTime?
  errorMessage             String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  requestedBy              AdminUser?       @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  emergencyBackupJob       BackupJob?       @relation("RestoreEmergencyBackup", fields: [emergencyBackupJobId], references: [id], onDelete: SetNull)

  @@index([status, requestedAt])
  @@index([requestedById, requestedAt])
  @@index([emergencyBackupJobId])
  @@index([maintenanceStartedAt])
  @@index([productionRestoreCompletedAt])
}

/// Durable progress and result tracking for long-running assistant operations.
model OperationRun {
  id           String             @id @default(cuid())
  type         OperationRunType
  status       OperationRunStatus @default(PENDING)
  step         String?
  percent      Int                @default(0)
  message      String?
  errorMessage String?
  targetType   String?
  targetId     String?
  result       Json?
  metadata     Json?
  startedById  String?
  startedBy    AdminUser?         @relation(fields: [startedById], references: [id], onDelete: SetNull)
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([type, status])
  @@index([startedById, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

/// Managed attendance devices (K40, future expansions).
model Device {
  id                     String               @id @default(cuid())
  name                   String
  type                   DeviceType           @default(OTHER)
  connectionType         DeviceConnectionType @default(NETWORK)
  enabled                Boolean              @default(true)
  status                 DeviceStatus         @default(UNKNOWN)
  lastSeenAt             DateTime?
  lastSuccessfulPollAt   DateTime?
  lastEventReceivedAt    DateTime?
  lastEventProcessedAt   DateTime?
  lastErrorAt            DateTime?
  lastErrorMessage       String?
  config                 Json                 @default("{}")
  model                  String?
  serialNumber           String?
  lastAttendanceRecordId Int?
  lastAttendanceAt       DateTime?
  lastPushAt             DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  rawLogs                DeviceRawLog[]
  inboxItems             InboxItem[]

  @@index([status])
  @@index([connectionType])
}

