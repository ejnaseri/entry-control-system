{
  "name": "client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:date-localization": "node --experimental-strip-types tests/date-input-values.test.ts",
    "test:date-localization-browser": "playwright test tests/date-localization.spec.ts",
    "test:auth-state-unit": "node --experimental-strip-types tests/auth-state.test.ts",
    "test:auth-state-component": "playwright test tests/auth-state.spec.ts",
    "test:auth-state": "npm run test:auth-state-unit && npm run test:auth-state-component",
    "test:route-manifest": "node --experimental-strip-types tests/route-manifest.test.ts",
    "test:route-boundary": "playwright test tests/route-boundary.spec.ts --workers=1",
    "test:navigation-surface": "playwright test tests/navigation-surface.spec.ts --workers=1",
    "test:edition-shell-visual": "playwright test tests/edition-shell-visual.spec.ts --workers=1",
    "test:attendance-shell-visual": "playwright test tests/attendance-shell-visual.spec.ts --workers=1",
    "test:attendance-inbox": "node scripts/run-attendance-inbox-test.mjs",
    "test:attendance-dashboard-visual": "playwright test tests/attendance-dashboard-visual.spec.ts --workers=1",
    "test:attendance-employees-visual": "playwright test tests/attendance-employees-visual.spec.ts --workers=1",
    "test:attendance-daily-visual": "playwright test tests/attendance-daily-visual.spec.ts --workers=1",
    "test:attendance-entry-logs-visual": "playwright test tests/attendance-entry-logs-visual.spec.ts --workers=1",
    "test:attendance-report-visual": "playwright test tests/attendance-report-visual.spec.ts --workers=1",
    "test:attendance-devices-visual": "playwright test tests/attendance-devices-visual.spec.ts --workers=1",
    "test:ui-primitives": "playwright test tests/ui-primitives.spec.ts --workers=1",
    "test:employees-ui": "playwright test tests/employees.spec.ts --workers=1",
    "test:attendance-ui": "playwright test tests/attendance-edition.spec.ts --workers=1",
    "test:devices-ui": "playwright test tests/device-edition.spec.ts --workers=1",
    "test:admin-users-ui": "playwright test tests/admin-users-edition.spec.ts --workers=1",
    "test:attendance-phase-3-7": "playwright test tests/attendance-phase-3-7.spec.ts --workers=1",
    "test:attendance-real-app": "playwright test tests/attendance-phase-3-7.spec.ts tests/attendance-shell-visual.spec.ts tests/attendance-dashboard-visual.spec.ts tests/attendance-employees-visual.spec.ts tests/attendance-daily-visual.spec.ts tests/attendance-entry-logs-visual.spec.ts tests/attendance-report-visual.spec.ts tests/attendance-devices-visual.spec.ts tests/attendance-settings-visual.spec.ts --workers=1",
    "test:attendance-settings-visual": "playwright test tests/attendance-settings-visual.spec.ts --workers=1",
    "test:product-brand": "node --experimental-strip-types tests/product-brand.test.ts",
    "test:route-build-boundary": "npm run build && node scripts/test-route-build-boundary.mjs",
    "test:route-build-boundary:scan": "node scripts/test-route-build-boundary.mjs",
    "test:edition-components": "playwright test tests/auth-state.spec.ts tests/route-boundary.spec.ts tests/navigation-surface.spec.ts tests/edition-shell-visual.spec.ts tests/ui-primitives.spec.ts tests/employees.spec.ts tests/attendance-edition.spec.ts tests/device-edition.spec.ts tests/admin-users-edition.spec.ts --workers=1",
    "test:report-downloads": "playwright test tests/report-downloads.spec.ts",
    "test:audit-logs": "playwright test tests/audit-logs.spec.ts",
    "test:expense-audit-live": "playwright test tests/expense-audit-live.spec.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tabler/icons-react": "^3.41.1",
    "@tanstack/react-query": "^5.90.15",
    "axios": "^1.13.2",
    "i18next": "^25.7.1",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.68.0",
    "react-i18next": "^16.4.0",
    "react-multi-date-picker": "^4.5.1",
    "react-router-dom": "^7.10.1",
    "recharts": "^2.15.4",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
