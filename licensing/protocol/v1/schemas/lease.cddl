; Entry Control System licensing protocol v1
; Root type: an ONLINE_LEASE-signed Hybrid Lease.

lease = #6.18([
  protected: bstr .cbor lease-protected,
  unprotected: {},
  payload: bstr .cbor lease-payload,
  signature: bstr .size 64
])

lease-protected = {
  1: -7,
  3: "application/vnd.entry-control.lease+cbor;v=1",
  4: key-id
}

lease-payload = {
  "protocolVersion": 1,
  "tokenType": "lease",
  "tokenId": opaque-id,
  "keyId": key-id,
  "issuedAt": utc-second,
  "notBefore": utc-second,
  "notAfter": utc-second,
  "productId": "ENTRY_CONTROL_SYSTEM",
  "edition": edition,
  "licenseId": opaque-id,
  "activationId": opaque-id,
  "installationId": opaque-id,
  "deviceKeyId": key-id,
  "mode": "HYBRID_LEASED",
  "assurance": assurance,
  "features": [1*23 feature],
  "entitlementTokenId": opaque-id,
  "entitlementGeneration": positive-counter,
  "leaseRevision": positive-counter,
  "serverTime": utc-second,
  "offlineUntil": utc-second,
  current-control-tuple,
  "leaseRequestId": opaque-id,
  "leaseRequestHash": sha-256,
  "versionIdentitySha256": sha-256,
  "buildIdentitySha256": sha-256,
  "buildManifestSha256": sha-256,
  ? "bindingRecoveryTokenId": opaque-id
}

feature =
  "ADMIN_USERS" /
  "ATTENDANCE_COMPLIANCE" /
  "ATTENDANCE_DAILY" /
  "ATTENDANCE_DASHBOARD" /
  "ATTENDANCE_EXPORT" /
  "ATTENDANCE_REPORTS" /
  "AUDIT_LOGS" /
  "AUTH" /
  "BACKUPS" /
  "CUSTOMERS" /
  "CUSTOMER_PAYMENTS" /
  "DEVICES" /
  "DEVICE_DIAGNOSTICS" /
  "DOOR_CONTROL" /
  "EMPLOYEES" /
  "ENTRY_LOGS" /
  "EXPENSES" /
  "FINANCIAL_REPORTS" /
  "INBOX" /
  "MEMBERSHIPS" /
  "PAYROLL" /
  "SOUNDS" /
  "STAFF_GROUPS"

edition = "FULL" / "ATTENDANCE"
assurance = "TPM_ATTESTED" / "SOFTWARE_BOUND"
lease-control-state = "OPERATIONAL" / "SUSPENDED"
current-control-tuple = (
  "controlRevision" => 0,
  "controlState" => "OPERATIONAL",
  "controlEffectiveAt" => 0,
  "controlReasonCode" => 0
//
  "controlRevision" => positive-counter,
  "controlState" => lease-control-state,
  "controlEffectiveAt" => utc-second,
  "controlReasonCode" => 1..5
)

opaque-id = bstr .size 16
sha-256 = bstr .size 32
key-id = bstr .size 32
counter = 0..9223372036854775807
positive-counter = 1..9223372036854775807
utc-second = 0..253402300799
